<main class="pokemon-list">
  <section
    class="container pokemon-list__content"
    aria-labelledby="pokemon-list-title"
  >
 
    <div class="pokemon-list__heading">
      <div>
        <p class="pokemon-list__eyebrow">National Pokédex</p>
        <h1 id="pokemon-list-title" class="pokemon-list__title">Pokémons</h1>
      </div>

      <p class="pokemon-list__summary">
        {{count}}
        species found
      </p>
    </div>

    <div
      class="pokemon-list__grid"
      data-pokemon-grid
      aria-live="polite"
      aria-busy="false"
    >
      {{#each pokemons}}
        <article class="pokemon-card">

          <a class="pokemon-card__link" href="/pokemons/{{id}}">

            <div class="pokemon-card__image-container">
              {{#if image}}
                <img
                  class="pokemon-card__image"
                  src="{{image}}"
                  alt="{{name}} image"
                  loading="lazy"
                />
              {{/if}}
            </div>

            <div class="pokemon-card__content">
              <span class="pokemon-card__id">
                #{{id}}
              </span>

              <h2 class="pokemon-card__name">
                {{name}}
              </h2>

              <ul class="pokemon-card__types" aria-label="Types">
                {{#each types}}
                  <li class="pokemon-card__type">
                    {{this}} 
                  </li>
                {{/each}}
              </ul>
            </div>
          </a>

        </article>
      {{/each}}
    </div>
    {{> pagination pagination}}
  </section>
</main>