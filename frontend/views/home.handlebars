<main class="pokemon-list">
  <section
    class="container pokemon-list__content"
    aria-labelledby="pokemon-list-title"
  >
  
    <div class="pokemon-list__heading">
      <div>
        <p class="pokemon-list__eyebrow">National Pokédex</p>
        <h1 id="pokemon-list-title" class="pokemon-list__title">Pokémons</h1>
      </div>

      <p class="pokemon-list__summary">
        {{count}}
        species found
      </p>
    </div>

    <form class="pokemon-search" role="search" data-pokemon-search-form>
      <label class="pokemon-search__label" for="pokemon-search-input">Search Pokémon</label>
      <div class="pokemon-search__control">
        <svg
          class="pokemon-search__icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="10.8" cy="10.8" r="6.8" fill="none" stroke="currentColor" stroke-width="1.8" />
          <path d="m16 16 4.2 4.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg> 
        <input
          class="pokemon-search__input"
          id="pokemon-search-input"
          name="q"
          type="search"
          placeholder="Search by Pokémon name..."
          autocomplete="off"
          spellcheck="false"
          aria-describedby="pokemon-search-help"
          data-pokemon-search
        />
      </div>
      <p class="pokemon-search__help" id="pokemon-search-help">
        Results update as you type.
      </p>
    </form>

    <div
      class="pokemon-list__grid"
      data-pokemon-grid
      aria-live="polite"
      aria-busy="false"
    >
      {{#each pokemons}}
        <article class="pokemon-card">

          <a class="pokemon-card__link" href="/pokemons/{{id}}">

            <div class="pokemon-card__image-container">
              {{#if image}}
                <img
                  class="pokemon-card__image"
                  src="{{image}}"
                  alt="{{name}} image"
                  loading="lazy"
                />
              {{/if}}
            </div>

            <div class="pokemon-card__content">
              <span class="pokemon-card__id">
                #{{id}}
              </span>

              <h2 class="pokemon-card__name">
                {{name}}
              </h2>

              <ul class="pokemon-card__types" aria-label="Types">
                {{#each types}}
                  <li class="pokemon-card__type">
                    {{this}} 
                  </li>
                {{/each}}
              </ul>
            </div>
          </a>

        </article>
      {{/each}}
    </div>
    {{> pagination pagination}}
  </section>
</main>