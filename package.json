{
  "devDependencies": {
    "concurrently": "^10.0.5",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev:backend": "cd backend && node --watch server.js",
    "dev:frontend": "cd frontend && node --watch server.js",
    "dev": "concurrently -k -n BACKEND,FRONTEND \"npm:dev:backend\" \"npm:dev:frontend\"",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:all": "vitest run"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-handlebars": "^9.0.1",
    "node-cache": "^5.1.2",
    "zod": "^4.4.3"
  },
  "type": "module",
  "private": true
}
