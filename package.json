{
	"name": "pokemon-app",
	"version": "1.0.0",
	"description": "Pok\u00e9dex web application built with Node.js and Express, featuring Pok\u00e9mon search, pagination, cache, and automated tests.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"concurrently": "^10.0.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"supertest": "^7.2.2",
		"vitest": "^4.1.10"
	},
	"scripts": {
		"dev:backend": "node --watch --env-file=.env backend/local-server.js",
		"dev:frontend": "node --watch --env-file=.env frontend/local-server.js",
		"dev": "concurrently -k -n BACKEND,FRONTEND \"npm:dev:backend\" \"npm:dev:frontend\"",
		"test": "vitest",
		"test:unit": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration",
		"test:e2e": "vitest run tests/e2e",
		"test:all": "vitest run",
		"prepare": "node scripts/prepare.js",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"start:backend": "node --env-file-if-exists=.env backend/local-server.js",
		"start:frontend": "node --env-file-if-exists=.env frontend/local-server.js"
	},
	"dependencies": {
		"express": "^5.2.1",
		"express-handlebars": "^9.0.1",
		"express-rate-limit": "^8.7.1",
		"helmet": "^8.3.0",
		"node-cache": "^5.1.2",
		"zod": "^4.4.3"
	}
}
